<Window x:Class="GoodNightPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⏰ 定时关机软件" 
        Height="720" 
        Width="540"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#f8f9fa"
        Icon="icon.ico"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <!-- 标题 -->
            <Border Background="#ecf0f1" 
                    BorderBrush="#34495e" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Margin="0,10,0,10"
                    Padding="15">
                <TextBlock Text="⏰ 定时关机软件" 
                          FontSize="20" 
                          FontWeight="Bold" 
                          FontFamily="Segoe UI Emoji, 微软雅黑"
                          Foreground="#2c3e50"
                          HorizontalAlignment="Center"/>
            </Border>

            <!-- 时间设置组 -->
            <GroupBox>
                <GroupBox.Header>
                    <TextBlock Text="⏱️ 设置关机时间" FontFamily="Segoe UI Emoji, 微软雅黑"/>
                </GroupBox.Header>
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Left" 
                           Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBox Name="HourTextBox" 
                                Width="70" 
                                Height="30" 
                                FontSize="14" 
                                Text="0" 
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"/>
                        <TextBlock Text="小时" 
                                  VerticalAlignment="Center" 
                                  Margin="8,0,0,0" 
                                  FontSize="12"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBox Name="MinuteTextBox" 
                                Width="70" 
                                Height="30" 
                                FontSize="14" 
                                Text="0" 
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"/>
                        <TextBlock Text="分钟" 
                                  VerticalAlignment="Center" 
                                  Margin="8,0,0,0" 
                                  FontSize="12"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="SecondTextBox" 
                                Width="70" 
                                Height="30" 
                                FontSize="14" 
                                Text="5" 
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"/>
                        <TextBlock Text="秒" 
                                  VerticalAlignment="Center" 
                                  Margin="8,0,0,0" 
                                  FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 关机选项 -->
            <GroupBox>
                <GroupBox.Header>
                    <TextBlock Text="🔌 关机选项" FontFamily="Segoe UI Emoji, 微软雅黑"/>
                </GroupBox.Header>
                <StackPanel Margin="5">
                    <RadioButton Name="HibernateRadio" 
                                IsChecked="True" 
                                GroupName="ShutdownOptions">
                        <TextBlock Text="😴 休眠" FontFamily="Segoe UI Emoji, 微软雅黑"/>
                    </RadioButton>
                    <RadioButton Name="ForceHibernateRadio" 
                                GroupName="ShutdownOptions">
                        <TextBlock Text="💤 强制休眠（不保存数据）" FontFamily="Segoe UI Emoji, 微软雅黑"/>
                    </RadioButton>
                    <RadioButton Name="ShutdownRadio" 
                                GroupName="ShutdownOptions">
                        <TextBlock Text="🔌 关机" FontFamily="Segoe UI Emoji, 微软雅黑"/>
                    </RadioButton>
                    <RadioButton Name="RestartRadio" 
                                GroupName="ShutdownOptions">
                        <TextBlock Text="🔄 重启" FontFamily="Segoe UI Emoji, 微软雅黑"/>
                    </RadioButton>
                    <RadioButton Name="ForceShutdownRadio" 
                                GroupName="ShutdownOptions">
                        <TextBlock Text="⚠️ 强制关机（不保存数据）" FontFamily="Segoe UI Emoji, 微软雅黑"/>
                    </RadioButton>
                </StackPanel>
            </GroupBox>

            <!-- 控制按钮 -->
            <Grid Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Name="StartButton" 
                        Grid.Column="0"
                        Content="开始定时" 
                        Style="{StaticResource StartButton}"
                        Click="StartButton_Click"/>
                
                <Button Name="StopButton" 
                        Grid.Column="2"
                        Content="取消定时" 
                        Style="{StaticResource StopButton}"
                        IsEnabled="False"
                        Click="StopButton_Click"/>
            </Grid>

            <!-- 状态显示 -->
            <TextBlock Name="StatusLabel" 
                      Text="状态：等待设置" 
                      FontSize="12" 
                      FontWeight="Bold" 
                      Foreground="#2196F3"
                      HorizontalAlignment="Center"
                      Margin="0,5"/>

            <!-- 倒计时显示 -->
            <Border Background="#FFF3E0" 
                    BorderBrush="#FF5722" 
                    BorderThickness="2" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="0,5,0,10">
                <TextBlock Name="CountdownLabel" 
                          Text="倒计时：--:--:--" 
                          FontSize="14" 
                          FontWeight="Bold" 
                          FontFamily="Segoe UI Emoji, 微软雅黑"
                          Foreground="#FF5722"
                          HorizontalAlignment="Center"/>
            </Border>

            <!-- 日志区域 -->
            <GroupBox>
                <GroupBox.Header>
                    <TextBlock Text="📋 操作日志" FontFamily="Segoe UI Emoji, 微软雅黑"/>
                </GroupBox.Header>
                <TextBox Name="LogTextBox" 
                        Height="150" 
                        IsReadOnly="True" 
                        VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap"
                        Background="#f5f5f5"
                        FontFamily="Segoe UI Emoji, 微软雅黑"
                        FontSize="9"/>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>

