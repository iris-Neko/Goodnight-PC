<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GoodNightPC.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="720"
        x:Class="GoodNightPC.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="定时关机软件"
        Width="540"
        Height="720"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#f8f9fa">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Name="PART_ScrollViewer">
        <StackPanel Margin="15">
            
            <!-- 标题 -->
            <Border Background="#ecf0f1" 
                    BorderBrush="#34495e" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Margin="0,10,0,10"
                    Padding="15">
                <TextBlock Text="定时关机软件" 
                          FontSize="20" 
                          FontWeight="Bold"
                          HorizontalAlignment="Center"/>
            </Border>

            <!-- 时间设置组 -->
            <HeaderedContentControl Header="⏱️ 设置关机时间" Margin="0,10,0,10">
                <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Padding="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <NumericUpDown Value="{Binding Hours}" 
                                          Minimum="0" 
                                          Maximum="23" 
                                          Width="100" 
                                          Height="38"
                                          ShowButtonSpinner="True"
                                          FormatString="0"
                                          Watermark="0"
                                          FontSize="15"
                                          Padding="5"
                                          AllowSpin="True"
                                          ButtonSpinnerLocation="Right"/>
                            <TextBlock Text="小时" 
                                      VerticalAlignment="Center" 
                                      Margin="10,0,0,0"
                                      FontSize="14"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <NumericUpDown Value="{Binding Minutes}" 
                                          Minimum="0" 
                                          Maximum="59" 
                                          Width="100" 
                                          Height="38"
                                          ShowButtonSpinner="True"
                                          FormatString="0"
                                          Watermark="0"
                                          FontSize="15"
                                          Padding="5"
                                          AllowSpin="True"
                                          ButtonSpinnerLocation="Right"/>
                            <TextBlock Text="分钟" 
                                      VerticalAlignment="Center" 
                                      Margin="10,0,0,0"
                                      FontSize="14"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal">
                            <NumericUpDown Value="{Binding Seconds}" 
                                          Minimum="0" 
                                          Maximum="59" 
                                          Width="100" 
                                          Height="38"
                                          ShowButtonSpinner="True"
                                          FormatString="0"
                                          Watermark="5"
                                          FontSize="15"
                                          Padding="5"
                                          AllowSpin="True"
                                          ButtonSpinnerLocation="Right"/>
                            <TextBlock Text="秒" 
                                      VerticalAlignment="Center" 
                                      Margin="10,0,0,0"
                                      FontSize="14"/>
                        </StackPanel>
                        
                    </StackPanel>
                </Border>
            </HeaderedContentControl>

            <!-- 关机选项 -->
            <HeaderedContentControl Header="🔌 关机选项" Margin="0,10,0,10">
                <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Padding="10">
                    <StackPanel>
                        <RadioButton Content="😴 休眠" 
                                    IsChecked="{Binding IsHibernate}"
                                    GroupName="ShutdownOptions"/>
                        <RadioButton Content="💤 强制休眠（不保存数据）" 
                                    IsChecked="{Binding IsForceHibernate}"
                                    GroupName="ShutdownOptions"/>
                        <RadioButton Content="🔌 关机" 
                                    IsChecked="{Binding IsShutdown}"
                                    GroupName="ShutdownOptions"/>
                        <RadioButton Content="🔄 重启" 
                                    IsChecked="{Binding IsRestart}"
                                    GroupName="ShutdownOptions"/>
                        <RadioButton Content="⚠️ 强制关机（不保存数据）" 
                                    IsChecked="{Binding IsForceShutdown}"
                                    GroupName="ShutdownOptions"/>
                    </StackPanel>
                </Border>
            </HeaderedContentControl>

            <!-- 控制按钮 -->
            <Grid Margin="0,10,0,10" ColumnDefinitions="*,10,*">
                <Button Grid.Column="0"
                        Content="开始定时" 
                        Classes="primary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding StartCommand}"/>
                
                <Button Grid.Column="2"
                        Content="取消定时" 
                        Classes="secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding StopCommand}"/>
            </Grid>

            <!-- 状态显示 -->
            <TextBlock Text="{Binding StatusText}" 
                      FontSize="12" 
                      FontWeight="Bold" 
                      Foreground="#2196F3"
                      HorizontalAlignment="Center"
                      Margin="0,5"/>

            <!-- 倒计时显示 -->
            <Border Background="#FFF3E0" 
                    BorderBrush="#FF5722" 
                    BorderThickness="2" 
                    CornerRadius="5" 
                    Padding="10"
                    Margin="0,5,0,10">
                <TextBlock Text="{Binding CountdownText}" 
                          FontSize="14" 
                          FontWeight="Bold" 
                          Foreground="#FF5722"
                          HorizontalAlignment="Center"/>
            </Border>

            <!-- 日志区域 -->
            <HeaderedContentControl Header="📋 操作日志" Margin="0,10,0,10">
                <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Padding="5">
                    <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                              FontSize="9" 
                                              TextWrapping="Wrap"
                                              Margin="2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </HeaderedContentControl>
            
        </StackPanel>
    </ScrollViewer>

</Window>

